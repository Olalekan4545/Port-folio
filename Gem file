source "https://rubygems.org"

gem "github-pages", "~> 228", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
  gem "jekyll-archives"
  gem "jemoji"
end

platforms :ruby do
  gem "http_parser.rb", "~> 0.6.0"
end
